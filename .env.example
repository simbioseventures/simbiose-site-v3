# Vercel: cadastre estas 8 variáveis nas configurações do projeto (COPY_TO_EMAIL é opcional).
# Node.js 24.x está selecionado no package.json.
APP_ORIGIN=https://www.simbioseventures.com

# Número do WhatsApp usado nos links "Fale com a Simbiose" (formato internacional,
# apenas dígitos, sem "+" nem espaços: DDI+DDD+número). Sem esta variável, os links
# abrem o seletor de contato do WhatsApp sem um número pré-selecionado.
PHONE_NUMBER=

# API do MailerSend; token com permissão de envio de e-mail.
MAILERSEND_API_TOKEN=
# Exemplo: use um remetente do domínio verificado na sua conta.
MAIL_FROM_EMAIL=site@simbioseventures.com
MAIL_FROM_NAME="Simbiose — Site"
CONTACT_TO_EMAIL=comercial@simbioseventures.com
# Opcional: recebe cópia (Cc) de cada contato enviado pelo formulário.
COPY_TO_EMAIL=

# Chaves reCAPTCHA v2: caixa de seleção "Não sou um robô".
# Cadastre o domínio de APP_ORIGIN no painel do reCAPTCHA.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Somente para a alternativa VPS; NÃO precisa cadastrar PORT na Vercel.
PORT=3000
