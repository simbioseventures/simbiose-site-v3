# Copie para .env.local (fora de dist/) para testar localmente com `npm run dev`.
# Este arquivo só sobrescreve APP_ORIGIN e PORT; os demais segredos continuam em .env.
# `npm run dev` carrega .env e depois .env.local, então os valores daqui têm prioridade.

# Precisa ser exatamente a origem usada no navegador. http é aceito somente para
# localhost/127.0.0.1 (ver server/contact.mjs); qualquer outro domínio exige https.
APP_ORIGIN=http://localhost:3000

# Porta do servidor local (servido por server/dev.mjs).
PORT=3000
