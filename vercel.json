{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "build/vercel-public",
  "functions": {
    "api/*.js": {"maxDuration": 30}
  },
  "rewrites": [
    {"source": "/api/contact/config.json", "destination": "/api/contact-config"},
    {"source": "/educacional", "destination": "/educacional/index.html"}
  ],
  "headers": [
    {"source": "/api/:path*", "headers": [{"key": "Cache-Control", "value": "no-store"}]}
  ]
}
